# Сервер Minecraft: файл Mojang перевыкладывать нельзя, а мир строится
# командами за секунду. Настройки сохранены отдельно как server.properties.primer
server/

# МОЗГИ целиком. Каждый весит 4.5 МБ и переписывается каждые 2000 шагов —
# в истории это превратилось бы в сотни мегабайт почти одинаковых файлов.
# Терять нечего: мозг всегда можно вырастить заново из кода и записей показа,
# а вот записи (pokaz/*.npz) незаменимы — это твоя живая игра, их храним.
models/

# Служебное
logs/
*.log
__pycache__/
*.pyc

# Остатки от скачивания сервера
manifest.json
ver.json
*url.txt
ssha.txt

# Картинки от проверок
proba-*.png
pokaz/brak/
proba-pupoviny/
sravnenie-glaz/
sravnenie-*.png
kadr-*.png

# ── от мода ──
# Сборка: Gradle делает всё это заново из исходников за пятнадцать секунд.
# Двадцать семь мегабайт скомпилированного в истории не нужны.
mod/build/
mod/.gradle/
mod/run/
mod/run-data/

# Папка отдельного клиента: логи, кэш, скачанное игрой. Мод сюда только
# копируется при сборке. Руками сделаны лишь настройки и список серверов —
# их и храним, остальное игра создаст сама.
klient/*
!klient/options.txt
!klient/servers.dat
